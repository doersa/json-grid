{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "json-grid",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",
      ".workbuddy",
      ".git",
      "tests",
      "scripts"
    ]
  }
}
